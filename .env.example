# ===========================================
# CodeWix - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values.
# For Cloudflare Pages, set secrets via:
#   wrangler secret put <VARIABLE_NAME>
# or in the Cloudflare Dashboard under Settings > Environment Variables.

# ---------- REQUIRED ----------

# Z.AI API Key (replaces old TOGETHER_API_KEY)
ZAI_API_KEY=zai_your_api_key_here

# Database connection string (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Supabase Authentication
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ---------- OPTIONAL ----------

# Public domain (used for OG images, share links, etc.)
# On Cloudflare Pages, CF_PAGES_URL is set automatically.
# Set this to override:
NEXT_PUBLIC_DOMAIN=https://codewix.com

# Local development URL
NEXT_PUBLIC_DEVELOPMENT_URL=http://localhost:3000

# S3-compatible upload storage (for file uploads)
S3_UPLOAD_KEY=
S3_UPLOAD_SECRET=
S3_UPLOAD_BUCKET=
S3_UPLOAD_REGION=

# Braintrust (observability / tracing)
BRAINTRUST_API_KEY=

# Braintrust project info
BRAINTRUST_PROJECT_ID=
BRAINTRUST_WORKSPACE_NAME=
